<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=System.Runtime"
                    xmlns:local="clr-namespace:FModel"
                    xmlns:controls="clr-namespace:FModel.Views.Resources.Controls"
                    xmlns:audioControls="clr-namespace:FModel.Views.Resources.Controls.Aup"
                    xmlns:converters="clr-namespace:FModel.Views.Resources.Converters"
                    xmlns:settings="clr-namespace:FModel.Settings"
                    xmlns:avalonedit="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
                    xmlns:folding="clr-namespace:AvaloniaEdit.Folding;assembly=AvaloniaEdit">

    <!-- ==================== Converters ==================== -->
    <converters:InvertBooleanConverter x:Key="BoolToVisibilityConverter" />

    <!-- ==================== TabItemFillSpace ==================== -->
    <Style x:Key="TabItemFillSpace"
           Selector="TabItem">
        <!-- TODO: Avalonia doesn't support binding Width via MultiBinding on TabItem easily.
             This style is a placeholder; actual fill-space behavior handled by TabControl. -->
    </Style>

    <!-- ==================== HighlightedCheckBox ==================== -->
    <!-- Original had a color animation on border; simplified for Avalonia. -->
    <Style x:Key="HighlightedCheckBox"
           Selector="CheckBox">
        <Setter Property="BorderThickness"
                Value="2" />
        <Setter Property="BorderBrush"
                Value="Goldenrod" />
    </Style>

    <!-- ==================== CustomSeparator ==================== -->
    <Style x:Key="CustomSeparator"
           Selector="Separator">
        <Setter Property="Margin"
                Value="0 8" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Separator Grid.Column="0"
                               VerticalAlignment="Center"
                               Margin="0" />
                    <TextBlock x:Name="TagTextBlock"
                               Grid.Column="1"
                               VerticalAlignment="Center"
                               Text="{TemplateBinding Tag}"
                               FontWeight="SemiBold"
                               FontSize="11"
                               Margin="10 0" />
                    <Separator Grid.Column="2"
                               VerticalAlignment="Center"
                               Margin="0" />
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- ==================== CustomVerticalSeparator ==================== -->
    <Style x:Key="CustomVerticalSeparator"
           Selector="Separator">
        <Setter Property="Margin"
                Value="8 0" />
        <Setter Property="RenderTransform">
            <RotateTransform Angle="90" />
        </Setter>
    </Style>

    <!-- ==================== DirectoryFilesListBox ==================== -->
    <Style x:Key="DirectoryFilesListBox"
           Selector="ListBox">
        <Setter Property="ItemsSource"
                Value="{Binding CUE4Parse.GameDirectory.DirectoryFilesView, FallbackValue={x:Null}}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility"
                Value="Disabled" />
        <Setter Property="ItemTemplate">
            <DataTemplate>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="25" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Image x:Name="ListImage"
                           Source="avares://FModel/Resources/archive.png"
                           Width="16"
                           Height="16"
                           HorizontalAlignment="Center"
                           Margin="0 0 3 0"
                           IsVisible="{Binding IsEnabled, Converter={x:Static converters:InvertBooleanConverter.Instance}}" />
                    <Image Source="avares://FModel/Resources/archive_enabled.png"
                           Width="16"
                           Height="16"
                           HorizontalAlignment="Center"
                           Margin="0 0 3 0"
                           IsVisible="{Binding IsEnabled}" />
                    <TextBlock Grid.Column="1"
                               HorizontalAlignment="Left"
                               Text="{Binding Name}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="3"
                               HorizontalAlignment="Right"
                               Text="{Binding Length, Converter={x:Static converters:SizeToStringConverter.Instance}}" />
                </Grid>
            </DataTemplate>
        </Setter>
    </Style>

    <!-- ==================== AudioFilesListBox ==================== -->
    <Style x:Key="AudioFilesListBox"
           Selector="ListBox">
        <Setter Property="ItemsSource"
                Value="{Binding AudioPlayer.AudioFilesView, FallbackValue={x:Null}}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility"
                Value="Disabled" />
        <Setter Property="ItemTemplate">
            <DataTemplate>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="25" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               HorizontalAlignment="Left"
                               Text="{Binding FileName}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2"
                               HorizontalAlignment="Right"
                               Text="{Binding Length, Converter={x:Static converters:SizeToStringConverter.Instance}}" />
                </Grid>
            </DataTemplate>
        </Setter>
    </Style>

    <!-- ==================== AssetsFolderTreeView ==================== -->
    <Style x:Key="AssetsFolderTreeView"
           Selector="TreeView">
        <Setter Property="ItemsSource"
                Value="{Binding CUE4Parse.AssetsFolder.FoldersView, FallbackValue={x:Null}}" />
        <Setter Property="ItemTemplate">
            <TreeDataTemplate ItemsSource="{Binding FoldersView, FallbackValue={x:Null}}">
                <StackPanel Orientation="Horizontal">
                    <Viewbox Width="16"
                             Height="16"
                             Margin="0 0 3.5 0">
                        <Canvas Width="24"
                                Height="24">
                            <Path Data="{Binding Header, Converter={x:Static converters:FolderToGeometryConverter.Instance}}" />
                        </Canvas>
                    </Viewbox>
                    <Border x:Name="TreeBadge"
                            CornerRadius="5"
                            Height="10"
                            MinWidth="10"
                            Background="#705542"
                            Margin="-10.5 0 4.5 0"
                            VerticalAlignment="Bottom"
                            IsVisible="{Binding AssetsList.Assets.Count, Converter={x:Static converters:IsNotZeroConverter.Instance}}">
                        <TextBlock Text="{Binding AssetsList.Assets.Count}"
                                   Margin="2.5 0 2.5 0"
                                   Padding="1 0 0 0"
                                   FontSize="7"
                                   Foreground="White"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{Binding Header}"
                               HorizontalAlignment="Left">
                        <TextBlock.ToolTip>
                            <ToolTip>
                                <TextBlock>
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0} has {1} folders and {2} packages">
                                            <Binding Path="Header" />
                                            <Binding Path="FoldersView.Count" />
                                            <Binding Path="AssetsList.Assets.Count" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </ToolTip>
                        </TextBlock.ToolTip>
                    </TextBlock>
                </StackPanel>
            </TreeDataTemplate>
        </Setter>
    </Style>

    <!-- ==================== GameFilesTabControl ==================== -->
    <Style x:Key="GameFilesTabControl"
           Selector="TabControl">
        <Setter Property="ItemsSource"
                Value="{Binding CUE4Parse.TabControl.TabsItems, FallbackValue={x:Null}}" />
        <Setter Property="SelectedItem"
                Value="{Binding CUE4Parse.TabControl.SelectedTab}" />
        <Setter Property="ItemTemplate">
            <DataTemplate>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left"
                               Text="{Binding Header}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding Header}" />
                    <Button Width="11"
                            Height="11"
                            Margin="10 0 -2.5 -1"
                            DockPanel.Dock="Right"
                            ToolTip.Tip="Close Tab"
                            Command="{Binding TabCommand}"
                            CommandParameter="Close_Tab" />
                </DockPanel>
            </DataTemplate>
        </Setter>
        <Setter Property="ContentTemplate">
            <DataTemplate>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="{Binding AvalonImageSize, Source={x:Static settings:UserSettings.Default}, Mode=TwoWay}" />
                    </Grid.ColumnDefinitions>

                    <controls:AvalonEditor x:Name="DynamicArea"
                                           Grid.Column="0"
                                           DataContext="{Binding SelectedItem, ElementName=TabControlName}" />
                    <GridSplitter Grid.Column="1"
                                  Width="4"
                                  VerticalAlignment="Stretch"
                                  IsVisible="{Binding SelectedItem.HasImage, ElementName=TabControlName}" />
                    <Border Grid.Column="2"
                            BorderBrush="#3b3d4a"
                            BorderThickness="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsVisible="{Binding SelectedItem.HasImage, ElementName=TabControlName}">
                        <Image VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               Stretch="Uniform"
                               IsVisible="{Binding SelectedItem.HasImage, ElementName=TabControlName}"
                               Source="{Binding SelectedItem.SelectedImage.Image, ElementName=TabControlName}">
                            <Image.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Disable Alpha Channel" />
                                    <MenuItem Header="Open Image"
                                              Command="{Binding DataContext.ImageCommand}"
                                              CommandParameter="Open">
                                        <MenuItem.Icon>
                                            <Viewbox Width="16"
                                                     Height="16">
                                                <Canvas Width="24"
                                                        Height="24">
                                                    <Path Fill="{DynamicResource TextControlForeground}"
                                                          Data="M20,4H4C2.9,4,2,4.9,2,6v12c0,1.1,0.9,2,2,2h16c1.1,0,2-0.9,2-2V6C22,4.9,21.1,4,20,4z M20,18H4V6h16V18z" />
                                                </Canvas>
                                            </Viewbox>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Copy Image"
                                              Command="{Binding DataContext.ImageCommand}"
                                              CommandParameter="Copy">
                                        <MenuItem.Icon>
                                            <Viewbox Width="16"
                                                     Height="16">
                                                <Canvas Width="24"
                                                        Height="24">
                                                    <Path Fill="{DynamicResource TextControlForeground}"
                                                          Data="{StaticResource CopyIcon}" />
                                                </Canvas>
                                            </Viewbox>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Save Image"
                                              Command="{Binding DataContext.ImageCommand}"
                                              CommandParameter="Save">
                                        <MenuItem.Icon>
                                            <Viewbox Width="16"
                                                     Height="16">
                                                <Canvas Width="24"
                                                        Height="24">
                                                    <Path Fill="{DynamicResource TextControlForeground}"
                                                          Data="{StaticResource SaveIcon}" />
                                                </Canvas>
                                            </Viewbox>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </Image.ContextMenu>
                        </Image>
                    </Border>
                    <TextBlock Grid.Column="2"
                               VerticalAlignment="Bottom"
                               HorizontalAlignment="Center"
                               IsVisible="{Binding SelectedItem.HasMultipleImages, ElementName=TabControlName}"
                               Text="{Binding SelectedItem.Page, ElementName=TabControlName}" />
                </Grid>
            </DataTemplate>
        </Setter>
    </Style>

    <!-- ==================== AvalonEdit TextEditor ==================== -->
    <!-- Default Fluent theme styling is used; no override needed for AvaloniaEdit -->

    <!-- ==================== CustomRichTextBox ==================== -->
    <!-- TODO: WPF RichTextBox/FlowDocument has no direct Avalonia equivalent.
         This style is a stub; the log display needs to be reimplemented
         using AvaloniaEdit TextEditor or a custom control. -->

    <!-- ==================== Magnifier Templates ==================== -->
    <!-- TODO: Magnifier is a custom WPF control that needs port to Avalonia.
         CircleTemplate and RectangleTemplate stubs provided. -->
    <ControlTemplate x:Key="CircleTemplate">
        <Grid />
    </ControlTemplate>
    <ControlTemplate x:Key="RectangleTemplate">
        <Grid />
    </ControlTemplate>

    <!-- ==================== UComboBox ==================== -->
    <!-- Simplified: uses built-in Fluent ComboBox with watermark placeholder -->
    <Style x:Key="UComboBox"
           Selector="ComboBox">
        <!-- TODO: AdonisUI WatermarkExtension replaced with Avalonia ComboBox.PlaceholderText when
    available -->
    </Style>

    <!-- ==================== PlayPauseToolbarButton ==================== -->
    <!-- TODO: CSCore PlaybackState binding not available yet (deferred to audio migration).
         Providing a simple play button style. -->
    <Style x:Key="PlayPauseToolbarButton"
           Selector="Button">
        <Setter Property="Content">
            <Viewbox Width="16"
                     Height="16">
                <Canvas Width="24"
                        Height="24">
                    <Path Fill="{DynamicResource TextControlForeground}"
                          Data="{StaticResource PlayIcon}" />
                </Canvas>
            </Viewbox>
        </Setter>
        <Setter Property="Background"
                Value="Transparent" />
        <Setter Property="BorderBrush"
                Value="Transparent" />
        <Setter Property="BorderThickness"
                Value="0" />
        <Setter Property="Padding"
                Value="2" />
        <Setter Property="ToolTip.Tip"
                Value="Play" />
    </Style>

    <!-- ==================== Audio Controls ==================== -->
    <!-- TODO: Audio control styles depend on CSCore (deferred to P3-013).
         Providing minimal stub styles. -->
    <Style Selector="audioControls|Timeline">
        <Setter Property="Height"
                Value="25" />
        <Setter Property="HorizontalAlignment"
                Value="Stretch" />
        <Setter Property="VerticalAlignment"
                Value="Bottom" />
    </Style>

    <Style Selector="audioControls|SpectrumAnalyzer">
        <Setter Property="HorizontalAlignment"
                Value="Stretch" />
        <Setter Property="VerticalAlignment"
                Value="Stretch" />
    </Style>

    <Style Selector="audioControls|Timeclock">
        <Setter Property="FontSize"
                Value="16" />
        <Setter Property="VerticalAlignment"
                Value="Top" />
        <Setter Property="HorizontalAlignment"
                Value="Right" />
        <Setter Property="Margin"
                Value="0 15 15 0" />
    </Style>

    <!-- ==================== FoldingMargin ==================== -->
    <Style Selector="folding|FoldingMargin">
        <Setter Property="FoldingMarkerBrush"
                Value="#262630" />
        <Setter Property="FoldingMarkerBackgroundBrush"
                Value="#262630" />
        <Setter Property="SelectedFoldingMarkerBrush"
                Value="#808080" />
        <Setter Property="SelectedFoldingMarkerBackgroundBrush"
                Value="#2A2B34" />
    </Style>

    <!-- ==================== ShadowEffect ==================== -->
    <!-- TODO: Avalonia uses BoxShadows on Border, not DropShadowEffect.
         This key is preserved but empty for compatibility. -->

    <!-- ==================== ModernToggleButtonStyle ==================== -->
    <Style x:Key="ModernToggleButtonStyle"
           Selector="ToggleButton">
        <Setter Property="BorderThickness"
                Value="1" />
        <Setter Property="Padding"
                Value="4" />
        <Setter Property="CornerRadius"
                Value="8" />
    </Style>

    <!-- ==================== AssetsExplorerToggleButtonStyle ==================== -->
    <Style x:Key="AssetsExplorerToggleButtonStyle"
           Selector="ToggleButton">
        <Setter Property="BorderThickness"
                Value="1" />
        <Setter Property="Padding"
                Value="4" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="8">
                    <Viewbox Width="18"
                             Height="18">
                        <Canvas Width="24"
                                Height="24">
                            <Path x:Name="IconPath"
                                  Data="{StaticResource FolderIconAlt}"
                                  Fill="{DynamicResource TextControlForeground}" />
                        </Canvas>
                    </Viewbox>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- ==================== Custom Expander Header ==================== -->
    <Style x:Key="CustomExpanderDownHeaderStyle"
           Selector="ToggleButton">
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="Transparent">
                    <Viewbox Width="16"
                             Height="16"
                             HorizontalAlignment="Center">
                        <Canvas Width="24"
                                Height="24">
                            <Path Fill="{TemplateBinding Foreground}"
                                  Data="{StaticResource ExpanderIcon}" />
                        </Canvas>
                    </Viewbox>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

</ResourceDictionary>
